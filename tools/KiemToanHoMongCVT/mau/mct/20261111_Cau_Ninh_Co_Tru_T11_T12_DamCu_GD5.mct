     9, LINE   , UNILOAD, GX, NO , NO, aDir[1], , , , 0, 8.8600001, 1, 9.2379999, 0, 0, 0, 0, , NO, 0, 0, NO, 
    10, LINE   , UNILOAD, GX, NO , NO, aDir[1], , , , 0, 9.2380001, 1, 11.3799999, 0, 0, 0, 0, , NO, 0, 0, NO, 

