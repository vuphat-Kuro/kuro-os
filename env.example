# Chép file này thành .env rồi sửa. KHÔNG commit .env.

KURO_STATE_DIR=state
KURO_BRAINS_DIR=brains
KURO_BRAIN=Brain Default
KURO_HOST=127.0.0.1
KURO_PORT=7788

# AI chạy Kuro: claude, anthropic, openrouter, deepseek, zai, kimi, ollama, custom.
# Để trống thì lần đầu mở Kuro sẽ hiện màn hình chọn AI. Nên chọn trên giao diện (⚙ Cài đặt).
KURO_PROVIDER=
KURO_AI_KEY=
# Chỉ cần với custom, hoặc Ollama ở máy khác
KURO_BASE_URL=

# Model riêng cho từng AI: KURO_MODEL_<AI viết hoa>, vd KURO_MODEL_CLAUDE=sonnet, KURO_MODEL_ANTIGRAVITY=gemini-3.8-flash-medium.
# Để trống = mặc định của AI đó. Nên chọn trên giao diện (ô chọn trên thanh trên cùng hoặc ⚙ Cài đặt).
KURO_MODEL_CLAUDE=

# Tool được phép tự chạy. Tool ngoài danh sách bị CHẶN (không hỏi).
# Thêm Bash nếu muốn Kuro chạy script Python của skill. Thêm mcp__<ten-server> để mở MCP, vd mcp__revit-mcp
KURO_ALLOWED_TOOLS=Read,Glob,Grep,Write,Edit,WebSearch,WebFetch,mcp__kuro__tinh_python

# Telegram (để trống = tắt). Lấy token ở @BotFather, ID của bạn ở @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_IDS=
