# Chép file này thành .env rồi sửa. KHÔNG commit .env.

KURO_STATE_DIR=state
KURO_BRAINS_DIR=brains
KURO_BRAIN=Brain Default
KURO_HOST=127.0.0.1
KURO_PORT=7788

# AI chạy Kuro: claude, anthropic, openrouter, deepseek, zai, kimi, ollama, custom.
# Để trống thì lần đầu mở Kuro sẽ hiện màn hình chọn AI. Nên chọn trên giao diện (⚙ Cài đặt).
KURO_PROVIDER=
KURO_AI_KEY=
# Chỉ cần với custom, hoặc Ollama ở máy khác
KURO_BASE_URL=

# Model riêng cho từng AI: KURO_MODEL_<AI viết hoa>, vd KURO_MODEL_CLAUDE=sonnet, KURO_MODEL_ANTIGRAVITY=gemini-3.8-flash-medium.
# Để trống = mặc định của AI đó. Nên chọn trên giao diện (ô chọn trên thanh trên cùng hoặc ⚙ Cài đặt).
KURO_MODEL_CLAUDE=

# Tool được phép tự chạy. Tool ngoài danh sách bị CHẶN (không hỏi).
# Mặc định đã bao gồm Bash để Kuro chạy script Python tính toán và tạo tệp HTML/Excel. Thêm mcp__<ten-server> để mở MCP, vd mcp__revit-mcp
KURO_ALLOWED_TOOLS=Read,Glob,Grep,Write,Edit,WebSearch,WebFetch,Bash,mcp__kuro__tinh_python

# Telegram (để trống = tắt). Lấy token ở @BotFather, ID của bạn ở @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_IDS=

# Đường dẫn kho dữ liệu mạng dùng chung - Công ty CP ĐTXD Giao thông Phương Thành
KURO_DATA_KTTC=\\phuongthanhtranconsin.data.com\12.KỸ THUẬT THI CÔNG
KURO_DATA_HD_DU_AN=\\phuongthanhtranconsin.data.com\4.HÀNH CHÍNH QUẢN TRỊ\HỢP ĐỒNG KINH TẾ - HỢP ĐỒNG DỰ ÁN\HĐ các Dự án
KURO_DATA_HD_THAU_PHU=\\phuongthanhtranconsin.data.com\4.HÀNH CHÍNH QUẢN TRỊ\HỢP ĐỒNG KINH TẾ - HỢP ĐỒNG DỰ ÁN\Hợp đồng kinh tế - Linh\HỢP ĐỒNG
